DATABASE_URL="file:../data/flexipack.db"

# OpenAI (optional — ohne Key greift der Regelparser)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Auth (optional — sonst wird ein Secret unter data/session-secret.txt erzeugt)
# FLEXIPACK_SESSION_SECRET=change-me-to-a-long-random-string

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Native iOS push (APNs) — .p8 key from Apple Developer → Keys, stored in the data volume
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=/app/data/apns/AuthKey.p8
APNS_BUNDLE_ID=ch.rolfwalker.flexipack
